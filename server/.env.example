# Copy to .env (gitignored) and fill in what you need.

# Resend (https://resend.com) — real login emails. Leave unset in dev
# to rely on the console-printed code/link.
RESEND_API_KEY=

# Turso (https://turso.tech) — hosted database for deployment. Leave
# unset in dev to use the local file server/data/ingrain.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Where magic links point. Defaults to http://localhost:5173.
CLIENT_URL=
